   "no": 23,
   "vol": "雪中の日光より",
   "kotobagaki": "",
   "author": "",
   "text": "雪の白綾かつぎしぬらん",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "kinoshita-naoe-6ad1c2eb-000024",
   "pid": "",
   "pages": [],
   "no": 24,
   "vol": "雪中の日光より",
   "kotobagaki": "",
   "author": "",
   "text": "去れど心さす方のある身には如何ばかり苦しかるらん、今も尚ほ繽紛として止まんともせず、せめては雪のはるゝを待ちて登山せん",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose",
   "ruby": [
    {
     "a": "繽紛",
     "r": "ひんぷん"
    }
   ]
  },
  {
   "id": "kinoshita-naoe-6ad1c2eb-000025",
