   "pages": [],
   "no": 18,
   "vol": "雪中の日光より",
   "kotobagaki": "",
   "author": "",
   "text": "覺束な、明日入る路や絶へぬらん",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "kinoshita-naoe-6ad1c2eb-000019",
