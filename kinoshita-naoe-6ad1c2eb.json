   "form": "prose"
  },
  {
   "id": "kinoshita-naoe-6ad1c2eb-000020",
   "pid": "",
   "pages": [],
   "no": 20,
   "vol": "雪中の日光より",
   "kotobagaki": "",
   "author": "",
   "text": "十七日、日光に泊りぬ、奧羽地方より雪ふみ分けて來ぬる參詣の旅客にて賑はし、",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "kinoshita-naoe-6ad1c2eb-000021",
   "pid": "",
   "pages": [],
   "no": 21,
   "vol": "雪中の日光より",
   "kotobagaki": "",
   "author": "",
   "text": "今朝起き出でぬれば雪積もること三尺、美觀言はん方なし",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "kinoshita-naoe-6ad1c2eb-000022",
   "pid": "",
   "pages": [],
   "no": 22,
   "vol": "雪中の日光より",
   "kotobagaki": "",
   "author": "",
   "text": "まれに來し人の爲めとや山姫は",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "kinoshita-naoe-6ad1c2eb-000023",
